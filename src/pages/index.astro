---
import '../styles/global.css'
import { projects, recommendations } from '../data/projects'

const dashboardIconsBase = 'https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg'
const sections = [
  { title: 'Projects', items: projects },
  { title: 'Recommendations', items: recommendations },
]

function iconUrl(icon: string) {
  return /^https?:\/\//.test(icon) ? icon : `${dashboardIconsBase}/${icon}.svg`
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Projects and recommendations." />
    <title>Faro</title>
  </head>
  <body class="bg-[#fafafa] font-sans text-[#171717]">
    <main class="mx-auto w-full max-w-[1020px] px-5 pt-16 pb-[88px] max-[650px]:px-3.5 max-[650px]:pt-9 max-[650px]:pb-15">
      <header class="mb-13 max-[650px]:mb-10">
        <h1 class="m-0 text-[21px] font-[650] tracking-[-0.03em]">Faro</h1>
        <p class="mt-1 text-sm text-neutral-500">Watch it unfolds.</p>
      </header>

      {sections.map((section, index) => (
        <section class:list={[index > 0 && 'mt-11']}>
          <h2 class="mb-3 text-xs leading-none font-semibold tracking-[0.08em] text-neutral-400 uppercase">{section.title}</h2>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(220px,260px))] justify-start gap-2.5 max-[650px]:grid-cols-1">
            {section.items.map((project) => (
              <article class="flex min-h-[106px] flex-col rounded-[14px] border border-neutral-200 bg-white px-3.5 py-[13px] transition-[border-color,transform] duration-[120ms] hover:-translate-y-px hover:border-neutral-300 max-[650px]:min-h-0">
                <div class="flex items-start justify-between gap-2.5">
                  <h3 class="mt-px text-sm font-[640] tracking-[-0.015em]">{project.name}</h3>
                  <nav class="flex shrink-0 gap-1" aria-label={`${project.name} links`}>
                    {project.links.map((link) => (
                      <a class="grid size-6 place-items-center rounded-lg hover:bg-neutral-100" href={link.url} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
                        {link.icon ? (
                          <img class="size-3.5" src={iconUrl(link.icon)} alt="" loading="lazy" />
                        ) : (
                          <svg class="size-3.5 text-neutral-500" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.1-2.46 3.18-5.46 3.18-9S14.1 5.46 12 3c-2.1 2.46-3.18 5.46-3.18 9S9.9 18.54 12 21ZM3.55 9h16.9M3.55 15h16.9" />
                          </svg>
                        )}
                      </a>
                    ))}
                  </nav>
                </div>
                <p class="mt-2.5 text-xs leading-[1.45] text-neutral-500">{project.description}</p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>
